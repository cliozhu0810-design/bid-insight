.workspace{padding:28rpx 24rpx 60rpx}.top,.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.name{font-size:42rpx;font-weight:700}.local{font-size:24rpx;color:#647d76}.steps{display:flex;margin:28rpx 0;gap:8rpx}.step{flex:1;background:#e3ebe7;padding:16rpx 8rpx;text-align:center;font-size:25rpx;clip-path:polygon(0 0,90% 0,100% 50%,90% 100%,0 100%,9% 50%)}.step:first-child{clip-path:polygon(0 0,90% 0,100% 50%,90% 100%,0 100%)}.current{background:#176e5d;color:#fff;font-weight:bold}.panel{padding:28rpx;margin:20rpx 0;border:1rpx solid #dce7e3;background:#fff;border-radius:20rpx}.heading{font-size:31rpx;font-weight:600}.muted{margin:12rpx 0;font-size:25rpx}.primary{margin-top:24rpx}.actions{display:flex;gap:12rpx;margin:22rpx 0;flex-wrap:wrap}.actions button{margin:0;font-size:24rpx}.document{border-top:1rpx solid #dce7e3;padding-top:24rpx;margin-top:24rpx}.filename{font-size:24rpx;word-break:break-all;color:#647d76}.notice,.status{background:#fff7e9;color:#83551e;padding:16rpx;font-size:25rpx;border-radius:10rpx;white-space:pre-wrap;margin:16rpx 0}.status{background:#eef6f2;color:#176e5d;word-break:break-all}.textbutton{font-size:26rpx;background:transparent;color:#176e5d;padding:12rpx 0;margin:8rpx 0}.pair{padding:20rpx;border:2rpx solid #e3ebe7;border-radius:12rpx;margin:18rpx 0}.selected{border-color:#176e5d;background:#eef6f2}.evidence{margin:28rpx 0;border-top:1rpx solid #dce7e3;padding-top:24rpx}.quote{padding:20rpx;background:#f4f7f6;margin:16rpx 0;border-radius:12rpx}.location{font-size:24rpx;color:#176e5d;font-weight:600}.source{display:block;white-space:pre-wrap;word-break:break-all;font-size:26rpx;margin:16rpx 0}.quote image{display:block;width:260rpx;margin:16rpx 0}.quote button{font-size:24rpx}input,textarea{box-sizing:border-box;width:100%;background:#f4f7f6;border:1rpx solid #dce7e3;border-radius:10rpx;padding:18rpx;margin:18rpx 0;font-size:27rpx}input{height:86rpx}textarea{height:180rpx}.overlay{position:fixed;inset:0;background:rgba(8,36,28,.45);z-index:20;padding:36rpx 24rpx;box-sizing:border-box}.editor{height:100%;background:white;border-radius:20rpx;box-sizing:border-box;padding:28rpx}.original{height:420rpx}.picker{padding:16rpx;background:#eef6f2;color:#176e5d}.field{border-bottom:1rpx solid #e3ebe7;padding:16rpx 0;font-size:25rpx}.field text{flex:1;word-break:break-all}switch{flex-shrink:0;transform:scale(.8);transform-origin:right center}.method text{white-space:pre-wrap;font-size:26rpx}

.report-canvas{position:fixed;left:-1200px;top:0;width:595px;height:842px;pointer-events:none}
